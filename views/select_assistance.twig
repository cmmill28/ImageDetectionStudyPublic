<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Select Assistance</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/interface.css">
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</head>
<body>
<div class="container text-center mt-4">
    <h1>Select Assistance</h1>
    <form id="assistanceForm" action="/activity/{{ userID }}/select_assistance" method="post">
        <input type="hidden" name="iteration" value="{{ iteration }}">
        <input type="hidden" id="timeTaken" name="timeTaken" value="">
        <div id="buttonsContainer" class="buttons-container">
            {% if leftOption.type == 'human' %}
                <button type="submit" name="selectedOption" value="left" class="btn btn-human btn-lg m-2" data-type="human"
                       data-toggle="tooltip" data-placement="bottom" title="Recommendations from expert human analysts">
                    Human Assistance: {{ leftOption.size | capitalize }}
                </button>
            {% else %}
                <button type="submit" name="selectedOption" value="left" class="btn btn-machine btn-lg m-2" data-type="machine"
                       data-toggle="tooltip" data-placement="bottom" title="Recommendations generated by an AI algorithm">
                    Machine Assistance: {{ leftOption.size | capitalize }}
                </button>
            {% endif %}
            
            {% if rightOption.type == 'human' %}
                <button type="submit" name="selectedOption" value="right" class="btn btn-human btn-lg m-2" data-type="human"
                       data-toggle="tooltip" data-placement="bottom" title="Recommendations from expert human analysts">
                    Human Assistance: {{ rightOption.size | capitalize }}
                </button>
            {% else %}
                <button type="submit" name="selectedOption" value="right" class="btn btn-machine btn-lg m-2" data-type="machine"
                       data-toggle="tooltip" data-placement="bottom" title="Recommendations generated by an AI algorithm">
                    Machine Assistance: {{ rightOption.size | capitalize }}
                </button>
            {% endif %}
        </div>
    </form>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
        
        const container = document.getElementById('buttonsContainer');
        const buttons = Array.from(container.children);
        if (Math.random() > 0.5) {
            buttons.reverse();
        }
        container.innerHTML = '';
        buttons.forEach(button => container.appendChild(button));

        // Reinitialize tooltips after rearranging buttons
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });

        const startTime = Date.now();

        const form = document.getElementById('assistanceForm');
        form.addEventListener('submit', function() {
            const endTime = Date.now();
            const timeTaken = ((endTime - startTime) / 1000).toFixed(2); // Time taken in seconds
            document.getElementById('timeTaken').value = timeTaken;
        });
    });
</script>
</body>
</html>
