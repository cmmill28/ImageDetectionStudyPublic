<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Practice Questions</title>

  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <link rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
  <script src="https://code.jquery.com/jquery-3.4.1.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

  <script src="/javascripts/loadactivity.js"></script>
  <link  rel="stylesheet" href="/stylesheets/activity.css">

  <style>
    html,body{height:100%;width:100%;margin:0}
    #complete{height:100%;width:100%;position:relative}
    #scaling-container{width:1920px;height:1080px;position:absolute;left:0;top:50px}
    .container{width:100%;height:100%}
  </style>
</head>

<body>
<div id="complete">
  <div id="scaling-container">
    <div class="container text-center mt-4">

      <div class="d-flex justify-content-center py-2">
        UserID:&nbsp;<span id="userID">{{ userID }}</span>
      </div>

      <h1 class="py-2">Practice Questions {{ questionNumber + 1 }} of 15</h1>
      <p class="py-2 text-danger" id="errorText1">{{ error }}</p>

      <p><b>Can you find this object in the image below?</b></p>
      <img id="targetObject" src="/images/activity/practice/target1.png"
           alt="Target Object" style="max-width:100px;">

      <p class="text-danger">Time remaining: <span id="time">00:15</span></p>

      <div class="content-wrapper">
        <div class="container mainContainer">
          <div class="image-container">
            <img id="img2find" src="/images/activity/practice/{{ questionImage }}"
                 alt="Question Image" class="large-image">
            <div id="timeup-message" class="text-danger" style="display:none">
              Times up! Submit your answer.
            </div>
          </div>
        </div>

        <div class="text-container">
          <div class="info-text">
            <p>This is the practice round.<br><br>
               Do your best to find the object and use the <em>Check</em> button to
               test your response.</p>
          </div>

          <div class="answeractivity">
            <p>Is the object in this image?</p>

            <div class="btn-group btn-group-toggle" data-toggle="buttons"
                 onclick="enableFunction()">
              <label class="btn btn-secondary" id="option11">
                <input type="radio" name="answer" value="Yes" autocomplete="off"
                       onclick="enableFunction()"> Yes
              </label>
              <label class="btn btn-secondary" id="option12">
                <input type="radio" name="answer" value="No"  autocomplete="off"
                       onclick="enableFunction()"> No
              </label>
            </div>

            <form id="subForm" action="/activity/{{ userID }}/practice" method="POST">
              <input type="hidden" id="questionNumber" name="questionNumber"
                     value="{{ questionNumber }}">
              <input type="hidden" id="correctAnswer" name="correctAnswer"
                     value="{{ correctAnswer }}">
              <input type="hidden" id="timeTaken" name="timeTaken" value="">
              <input type="hidden" id="timeExpired" name="timeExpired" value="false">
              <input type="hidden" id="selectedAnswer" name="selectedAnswer" value="">
              <p class="py-2 text-danger" id="errorText2">{{ error }}</p>

              <button type="button" class="btn btn-outline-primary"
                      id="checkButton" disabled>Check</button><br><br>
              <input type="submit" class="btn btn-outline-success"
                     id="submitButton" value="Next" disabled>
            </form>

            <div class="alert alert-info mt-4" id="feedback" style="display:none">
              <strong id="feedbackText">{{ feedback }}</strong>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- scaling helper ----------------------------------------------------- -->
<script>
function scaleContent(){
  const c=document.getElementById('scaling-container');
  const scale=Math.min(window.innerWidth/1920,window.innerHeight/1080);
  c.style.transform=`scale(${scale})`;
  c.style.transformOrigin='top left';
}
window.addEventListener('resize',scaleContent);
window.addEventListener('load',  scaleContent);
</script>

<!-- main interaction logic --------------------------------------------- -->
<script>
function enableFunction(){ document.getElementById('checkButton').disabled=false; }

document.addEventListener('DOMContentLoaded',()=>{

  const checkBtn   = document.getElementById('checkButton');
  const submitBtn  = document.getElementById('submitButton');
  const feedback   = document.getElementById('feedback');
  const feedbackTx = document.getElementById('feedbackText');
  const timeDisp   = document.getElementById('time');
  const timeMsg    = document.getElementById('timeup-message');
  const img2find   = document.getElementById('img2find');   /* NEW: reference */

  let checked=false, timeExpired=false, timerRunning=false;

  /* radio-button state */
  document.querySelectorAll('input[name="answer"]').forEach(inp=>{
    inp.addEventListener('change',()=>{
      checkBtn.disabled=true;         /* stay disabled until first “enableFunction” call */
      feedback.style.display='none';
      checked=false;
    });
  });

  /* Check button */
  checkBtn.addEventListener('click',()=>{
    /* bring the image back once user checks */
    img2find.style.visibility='visible';          /* ← NEW LINE */

    const sel=document.querySelector('input[name="answer"]:checked');
    if(!sel){ alert('Please select Yes or No before checking.'); return; }

    const correct=document.getElementById('correctAnswer').value;
    const look="{{ look }}";

    if(sel.value===correct){
      feedbackTx.textContent='Correct!';
      feedback.classList.replace('alert-danger','alert-info');
    }else{
      feedbackTx.textContent=correct==='Yes'
        ? `Incorrect. The correct answer was Yes.\nThe object is located ${look}.`
        : 'Incorrect. The correct answer was No.';
      feedback.classList.replace('alert-info','alert-danger');
    }

    feedback.style.display='block';
    submitBtn.disabled=false;
    checked=true;
  });

  /* submit guard */
  document.getElementById('subForm').onsubmit=()=>{
    if(!checked){ alert('Please check your answer before submitting.'); return false; }

    const secs=parseInt(timeDisp.textContent.split(':')[1],10);
    document.getElementById('timeTaken').value = 15-(isNaN(secs)?15:secs);
    document.getElementById('timeExpired').value = timeExpired;
    document.getElementById('selectedAnswer').value =
      document.querySelector('input[name="answer"]:checked').value;
  };

  /* ----------- SINGLE, non-restartable countdown ----------- */
  function startTimer(seconds){
    if(timerRunning) return;
    timerRunning=true;

    let t=seconds;
    const iv=setInterval(()=>{
      const s=t<10?`0${t}`:t;
      timeDisp.textContent=`00:${s}`;

      if(--t<0){
        clearInterval(iv);
        timeExpired=true;

        timeDisp.textContent='00:00';
        timeMsg.style.display='block';

        /* hide the image after time runs out */
        img2find.style.visibility='hidden';       /* ← NEW LINE */

        checkBtn.disabled=false;   // still allow answer checking
        submitBtn.disabled=false;
      }
    },1000);
  }
  startTimer(15);
});
</script>
</body>
</html>
